{
  "name": "@crm/api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "rm -rf .test-out && tsc -p tsconfig.json --outDir .test-out && node --test --test-concurrency=1 --test-reporter=spec \".test-out/test/**/*.test.js\"",
    "start": "node dist/main.js",
    "bootstrap": "node dist/cli/bootstrap.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/multipart": "^9.0.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-fastify": "^12.0.0",
    "@node-rs/argon2": "^2.0.0",
    "csv-parse": "^7.0.2",
    "csv-stringify": "^6.6.0",
    "fastify": "^5.0.0",
    "file-type": "^21.0.0",
    "libphonenumber-js": "^1.12.0",
    "nodemailer": "^10.0.6",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.11.0",
    "typescript": "^6.0.0"
  }
}
